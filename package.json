{
  "name": "llkyta-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "KD_klin personal homepage",
  "scripts": {
    "lint:js": "eslint \"static/js/**/*.js\"",
    "lint:css": "stylelint \"static/css/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "fix:js": "eslint \"static/js/**/*.js\" --fix",
    "fix:css": "stylelint \"static/css/**/*.css\" --fix",
    "format": "prettier --write \"**/*.{html,css,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md,yml,yaml}\"",
    "fix": "npm run fix:js && npm run fix:css && npm run format",
    "check:dom": "node tools/check-dom.js",
    "check": "npm run lint && npm run format:check && npm run check:dom"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "prettier": "^3.3.0",
    "stylelint": "^16.6.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.4"
  }
}
